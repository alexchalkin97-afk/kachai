<?xml version="1.0" encoding="utf-8"?>
<!-- Всё по HTTPS, кроме файла настроек туннеля на нашем сервере (remoteConfigUrl)
     и службы поиска kachai.api — до неё запрос идёт только внутри зашифрованного туннеля -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">5.187.1.101</domain>
        <domain includeSubdomains="false">kachai.api</domain>
    </domain-config>
</network-security-config>
