# Скопируйте в secrets.properties и заполните. Файл secrets.properties в git не попадает.

# Страница оформления подписки и API активации кодов (пока не готовы — оставьте пустыми)
premiumUrl=
apiBase=

# Ссылка на исходный код (требование лицензии GPL-3.0)
sourceUrl=

# Ссылка на политику конфиденциальности (docs/privacy.html, выложенная в интернет)
privacyUrl=

# Почта для отчётов об ошибках («Настройки → Отправить отчёт»). Пусто — alexchalkin97@bk.ru
supportEmail=

# Бесплатная версия: загрузок в день и максимальное разрешение видео
freeDailyLimit=3
freeMaxHeight=720

# Цена Плюса для экрана подписки
premiumPrice=99 ₽ в месяц

# ID рекламных блоков Яндекса. Пусто = демо-реклама
ads.banner=
ads.interstitial=
ads.rewarded=

# Код тестировщика: вводится в «Плюс» → «У меня есть код», включает Плюс без оплаты.
# В APK попадает только его хэш.
testerCode=

# RuStore: ID приложения из адреса Консоли (console.rustore.ru/apps/<ID>) и идентификатор подписки
rustore.appId=
rustore.subscriptionId=
# Другие тарифы Плюса — технические ID товаров из Консоли («Монетизация»). Пусто — тарифа нет.
# Годовая подписка; разовый Плюс на 30 и 365 дней — потребляемые товары, без автопродления
rustore.yearlyId=
rustore.passMonthId=
rustore.passYearId=

# Открытый ключ промокодов: печатает «java tools/promo/PromoCodes.java keygen». Пусто — промокоды выключены
promo.publicKey=

# Канал или группа приложения (Telegram, VK) — ссылка в настройках. Пусто — пункта нет
communityUrl=

# AppMetrica: API-ключ приложения (appmetrica.yandex.ru → Настройки). Пусто — статистика выключена
appmetrica.apiKey=
