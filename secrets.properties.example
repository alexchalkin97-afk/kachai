# Скопируйте в secrets.properties и заполните. Файл secrets.properties в git не попадает.

# Параметры VPS — их печатает server/install-vps.sh в конце установки
vps.host=
vps.port=443
vps.uuid=
vps.sni=
vps.publicKey=
vps.shortId=

# Необязательно: адрес JSON с актуальными серверами (на случай блокировки IP).
# Формат — см. README, раздел «Смена сервера без обновления приложения».
remoteConfigUrl=

# Страница оформления подписки и API активации кодов (пока не готовы — оставьте пустыми)
premiumUrl=
apiBase=

# Ссылка на исходный код (требование лицензии GPL-3.0)
sourceUrl=

# Бесплатная версия: загрузок в день и максимальное разрешение видео
freeDailyLimit=3
freeMaxHeight=720

# Цена Плюса для экрана подписки
premiumPrice=349 ₽ в месяц

# ID рекламных блоков Яндекса. Пусто = демо-реклама
ads.banner=
ads.interstitial=
ads.rewarded=

# Код тестировщика: вводится в «Плюс» → «У меня есть код», включает Плюс без оплаты.
# В APK попадает только его хэш.
testerCode=

# RuStore: ID приложения из адреса Консоли (console.rustore.ru/apps/<ID>) и идентификатор подписки
rustore.appId=
rustore.subscriptionId=

# AppMetrica: API-ключ приложения (appmetrica.yandex.ru → Настройки). Пусто — статистика выключена
appmetrica.apiKey=
